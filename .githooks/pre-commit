#!/bin/sh
set -eu

blocked_files="$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env($|\.|/)' | grep -vE '(^|/)\.env(\..*)?example$' || true)"

if [ -n "$blocked_files" ]; then
  echo "Commit blocked: staged environment files may contain secrets." >&2
  echo "$blocked_files" >&2
  echo "Use .env.example for placeholders and keep real values in .env.local or hosting secrets." >&2
  exit 1
fi

secret_lines="$(git diff --cached --unified=0 --diff-filter=ACMR | grep -E '^\+[^+].*(SECRET|TOKEN|API_KEY|PRIVATE_KEY|PASSWORD)[A-Z0-9_]*[[:space:]]*=[[:space:]]*.+' | grep -vE '=$|<redacted>|example|placeholder|process\.env' || true)"

if [ -n "$secret_lines" ]; then
  echo "Commit blocked: staged diff appears to contain a secret assignment." >&2
  echo "$secret_lines" >&2
  echo "Move real values to .env.local or your hosting provider secret store." >&2
  exit 1
fi

exit 0

